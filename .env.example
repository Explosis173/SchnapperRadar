# ============ Pflicht ============
# App-Passwort (mind. 12 Zeichen). Erzeugen z. B.: openssl rand -base64 24
Auth__Password=
# Datenbank-Passwort (nur intern zwischen App und DB)
POSTGRES_PASSWORD=
# Deine PLZ – für Abhol-Entfernung und Fahrtkosten
Home__PostalCode=10115

# Always = nur über HTTPS (Cloud). SameAsRequest = lokal über http://localhost bzw. im LAN.
Auth__CookieSecure=SameAsRequest

# ============ Kosten ============
# Sprit + Verschleiß pro km, max. Abholentfernung
Home__CarCostPerKm=0.30
Home__MaxPickupDistanceKm=50

# ============ KI – genau EINE Variante aktiv lassen ============

# --- KOSTENLOS (Standard): Gemini Free Tier, Modell wird automatisch gewählt ---
# Key gratis mit deinem Google-Konto: https://aistudio.google.com/apikey
Ai__Provider=gemini
Ai__Model=auto
Ai__ApiKey=
# Optionale Gratis-Fallbacks, falls Gemini ins Rate-Limit läuft (leer lassen = wird ignoriert):
# Groq-Key gratis: https://console.groq.com/keys
Ai__Fallbacks__0__Provider=groq
Ai__Fallbacks__0__ApiKey=
# GitHub-Token (fine-grained, Berechtigung "Models: read"): https://github.com/settings/personal-access-tokens
Ai__Fallbacks__1__Provider=github
Ai__Fallbacks__1__ApiKey=

# --- Microsoft Foundry (bestes Preis-Leistungs-Verhältnis bei bezahlt: gpt-5-nano) ---
# BaseUrl: https://<resource>.openai.azure.com/openai/v1/  oder  https://<resource>.services.ai.azure.com/openai/v1/
# Model = Name deines Deployments
# Ai__Provider=foundry
# Ai__BaseUrl=https://DEIN-RESOURCE.openai.azure.com/openai/v1/
# Ai__Model=gpt-5-nano
# Ai__ApiKey=
# Ai__ReasoningEffort=minimal
# Tipp: Foundry als Haupt-KI und Gemini als Gratis-Fallback geht auch:
# Ai__Fallbacks__0__Provider=gemini
# Ai__Fallbacks__0__ApiKey=

# --- Claude über Microsoft Foundry ---
# Ai__Provider=foundry-claude
# Ai__BaseUrl=https://DEIN-RESOURCE.services.ai.azure.com/anthropic/
# Ai__Model=claude-haiku-5-5
# Ai__ApiKey=

# --- Kostenlos: GitHub Models (Token mit deinem GitHub-Konto, Scope "models:read") ---
# Ai__Provider=github
# Ai__Model=openai/gpt-4.1-mini
# Ai__ApiKey=

# --- Claude direkt (Anthropic API-Key, console.anthropic.com) ---
# Ai__Provider=anthropic
# Ai__Model=claude-haiku-5-5
# Ai__ApiKey=

# --- ChatGPT/OpenAI direkt (API-Key, platform.openai.com) ---
# Ai__Provider=openai
# Ai__Model=gpt-5-nano
# Ai__ApiKey=
# Ai__ReasoningEffort=minimal

# --- Lokal mit Ollama (siehe docker-compose.onprem.yml) ---
# OLLAMA_MODEL=gemma3:12b

# --- Aus: nur Heuristik, kostet nichts ---
# Ai__Provider=none

# ============ Feintuning (optional) ============
# Pipeline__EnrichTopK=20
# Pipeline__AiTopK=8
# Pipeline__MinTrustForAi=40
# Feed__RefreshMinutes=60
# Feed__MinScore=55
# Scraper__KleinanzeigenEnabled=true
# Scraper__VintedEnabled=true
