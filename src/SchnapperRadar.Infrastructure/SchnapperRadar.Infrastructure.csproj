  <ItemGroup>
    <EmbeddedResource Include="Geo/plz_geocoord.csv" LogicalName="SchnapperRadar.plz_geocoord.csv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SchnapperRadar.Tests" />
